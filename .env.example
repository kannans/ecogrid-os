# EcoGrid OS — Phase 1 environment template.
# Copy to `.env` and adjust. Every worker variable is prefixed ECOGRID_.

# ---------------------------------------------------------------------------
# Docker Compose stack
# ---------------------------------------------------------------------------
# Host-side published ports. Change these if your machine already runs native
# PostgreSQL (5432) or Redis (6379) — a very common collision on dev machines.
# Only the host binding moves; the in-container ports stay at their defaults.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Must match ECOGRID_KAFKA_BOOTSTRAP_SERVERS below if you change it.
KAFKA_HOST_PORT=9092

POSTGRES_DB=ecogrid
POSTGRES_USER=ecogrid
POSTGRES_PASSWORD=change_me_in_non_local_envs

KAFKA_TELEMETRY_TOPIC=ecogrid.telemetry.carbon
KAFKA_DLQ_TOPIC=ecogrid.telemetry.carbon.dlq

# ---------------------------------------------------------------------------
# Ingestion worker
# ---------------------------------------------------------------------------
# In-network (docker compose): kafka:29092  |  On the host: localhost:9092
ECOGRID_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ECOGRID_KAFKA_TOPIC=ecogrid.telemetry.carbon
ECOGRID_KAFKA_CLIENT_ID=ecogrid-grid-ingestor
ECOGRID_KAFKA_TOPIC_PARTITIONS=3
ECOGRID_KAFKA_TOPIC_REPLICATION_FACTOR=1
ECOGRID_KAFKA_MAX_ATTEMPTS=5
ECOGRID_KAFKA_BACKOFF_BASE_SECONDS=1.0
ECOGRID_KAFKA_BACKOFF_MAX_SECONDS=30.0
ECOGRID_KAFKA_BROKER_WAIT_SECONDS=90.0

# UK Carbon Intensity API — do not add trailing slashes.
ECOGRID_INTENSITY_URL=https://api.carbonintensity.org.uk/intensity
ECOGRID_GENERATION_URL=https://api.carbonintensity.org.uk/generation
ECOGRID_HTTP_TIMEOUT_SECONDS=15.0
ECOGRID_HTTP_MAX_ATTEMPTS=5
ECOGRID_HTTP_BACKOFF_BASE_SECONDS=1.0
ECOGRID_HTTP_BACKOFF_MAX_SECONDS=60.0

# 300s keeps us well inside the public rate limit (the API is half-hourly).
ECOGRID_POLL_INTERVAL_SECONDS=300

# Local durability spool + liveness heartbeat.
ECOGRID_SPOOL_PATH=./data/spool/telemetry-spool.jsonl
ECOGRID_SPOOL_MAX_RECORDS=10000
ECOGRID_HEARTBEAT_PATH=./data/heartbeat

# Set true to republish every window each cycle (default: suppress unchanged).
ECOGRID_PUBLISH_UNCHANGED_WINDOWS=false

ECOGRID_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Phase 2 — Platform Core (Kafka consumer + FastAPI service)
# ---------------------------------------------------------------------------
# Host-side API port. Change if 8000 is taken.
API_HOST_PORT=8000

# Credentials and datastores. The DSN may use either `postgresql://` or
# `postgresql+asyncpg://` — the async driver is injected automatically.
# Use the host-mapped ports here (see POSTGRES_HOST_PORT / REDIS_HOST_PORT
# above) when running the services from a venv rather than from Compose.
ECOGRID_POSTGRES_DSN=postgresql://ecogrid:change_me_in_non_local_envs@localhost:5432/ecogrid
ECOGRID_REDIS_URL=redis://localhost:6379/0

# Consumer
ECOGRID_KAFKA_CONSUMER_GROUP=ecogrid-platform-core
ECOGRID_KAFKA_CLIENT_ID=ecogrid-telemetry-consumer
# `earliest` backfills the retained topic on a fresh consumer group.
ECOGRID_KAFKA_AUTO_OFFSET_RESET=earliest
ECOGRID_KAFKA_MAX_POLL_RECORDS=200

# API
ECOGRID_API_DOCS_ENABLED=true
ECOGRID_API_DEFAULT_PAGE_SIZE=50
ECOGRID_API_MAX_PAGE_SIZE=500

# Auth — leave blank to have `migrate` generate an admin key and print it once.
# Set it in CI/secret managers where a deterministic bootstrap is required.
ECOGRID_BOOTSTRAP_ADMIN_KEY=

# Rate limiting (per API key, or per client IP when unauthenticated)
ECOGRID_RATE_LIMIT_ENABLED=true
ECOGRID_RATE_LIMIT_REQUESTS=120
ECOGRID_RATE_LIMIT_WINDOW_SECONDS=60

