# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest_tmp/
*.egg-info/

# Local secrets & config
.env

# Runtime state produced by the ingestion worker
data/spool/*.jsonl
data/spool/*.tmp
data/heartbeat

# OS noise
.DS_Store

# Tooling caches
.ruff_cache/

# Dashboard build artefacts
dashboard/node_modules/
dashboard/dist/
dashboard/.npm-cache/
# Vite writes a temp config shim next to vite.config.ts on every build.
dashboard/vite.config.ts.timestamp-*

# Generated TLS material (self-signed dev certs)
certs/

# Alembic runtime
alembic/.venv/
